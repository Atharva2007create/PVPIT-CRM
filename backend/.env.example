NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pvpit_crm
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
PASSWORD_MIN_LENGTH=10
CLIENT_ORIGIN=http://localhost:5173

# Development placeholders only. Replace with approved institutional patterns.
STUDENT_EMAIL_PATTERN=^student\.[a-z0-9]+@pvpit\.test$
ADMINISTRATOR_EMAIL_PATTERN=^admin\.[a-z0-9]+@pvpit\.test$

# Uncomment and set only when running `npm run bootstrap:admin`.
# INITIAL_ADMIN_NAME=
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
